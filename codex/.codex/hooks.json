{
  "description": "Record Codex session identity for tmux workspace recovery.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-workspace-resurrect/scripts/record-agent-session.sh\" codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
