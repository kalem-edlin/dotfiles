// Place your key bindings in this file to override the defaults
// Using tmux-style chord keybindings: ctrl+a then <key>
// Vim-style H/J/K/L navigation:
//   H/L = horizontal: [Sidebar] ←H─ [Split1] ←H─L→ [SplitN] ─L→ [AI Chat]
//   J/K = vertical:   [Upper] ←K─J→ [Lower] (for vertically stacked splits)
[
  // ============================================
  // VIM-STYLE PANEL NAVIGATION (H=left, L=right)
  // Supports split editor groups
  // ============================================

  // --- FROM EDITOR (with split view support) ---
  // ctrl+a h - Go left: to left split (directional), OR to sidebar if at first split
  // Uses focusLeftGroup for visual left navigation (won't traverse vertical splits)
  {
    "key": "ctrl+a h",
    "command": "workbench.action.focusLeftGroup",
    "when": "editorFocus && activeEditorGroupIndex != 1"
  },
  {
    "key": "ctrl+a h",
    "command": "workbench.view.explorer",
    "when": "editorFocus && activeEditorGroupIndex == 1"
  },
  // ctrl+a l - Go right: to right split (directional), OR to AI Chat if at last split
  // Uses focusRightGroup for visual right navigation (won't traverse vertical splits)
  {
    "key": "ctrl+a l",
    "command": "workbench.action.focusRightGroup",
    "when": "editorFocus && !activeEditorGroupLast"
  },
  {
    "key": "ctrl+a l",
    "command": "workbench.action.focusAuxiliaryBar",
    "when": "editorFocus && activeEditorGroupLast"
  },

  // --- FROM ANY LEFT SIDEBAR (file explorer, search, git, extensions, etc.) ---
  // ctrl+a l - Go right to FIRST editor split (when in ANY sidebar view)
  {
    "key": "ctrl+a l",
    "command": "workbench.action.focusFirstEditorGroup",
    "when": "sideBarFocus || sideBarVisible && listFocus || explorerViewletFocus || filesExplorerFocus || searchViewletFocus || scmViewletFocus"
  },
  // ctrl+a h - Go more left = close sidebar, focus editor (when in ANY sidebar)
  {
    "key": "ctrl+a h",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.focusFirstEditorGroup"
      ]
    },
    "when": "sideBarFocus || sideBarVisible && listFocus || explorerViewletFocus || filesExplorerFocus || searchViewletFocus || scmViewletFocus"
  },

  // --- QUICK EXPLORER TOGGLE ---
  // ctrl+a ctrl+a - Toggle file explorer from anywhere
  {
    "key": "ctrl+a ctrl+a",
    "command": "workbench.view.explorer",
    "when": "editorFocus"
  },
  // ctrl+a ctrl+a - Close sidebar and focus editor (when sidebar is focused)
  {
    "key": "ctrl+a ctrl+a",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.focusFirstEditorGroup"
      ]
    },
    "when": "sideBarFocus || sideBarVisible && listFocus || explorerViewletFocus || filesExplorerFocus || searchViewletFocus || scmViewletFocus"
  },

  // --- FROM AI CHAT (right auxiliary bar) ---
  // ctrl+a h - Go left to LAST editor split (when in auxiliary bar)
  {
    "key": "ctrl+a h",
    "command": "workbench.action.focusLastEditorGroup",
    "when": "auxiliaryBarFocus"
  },
  // ctrl+a l - Go more right = close auxiliary bar, focus last editor (when in aux bar)
  {
    "key": "ctrl+a l",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.toggleAuxiliaryBar",
        "workbench.action.focusLastEditorGroup"
      ]
    },
    "when": "auxiliaryBarFocus"
  },

  // ============================================
  // SPLIT EDITOR (ctrl+a / horizontal, ctrl+a \ vertical)
  // ============================================
  // ctrl+a / - Split editor to the right (horizontal split)
  {
    "key": "ctrl+a /",
    "command": "workbench.action.splitEditorRight"
  },
  // ctrl+a \ - Split editor down (vertical split)
  {
    "key": "ctrl+a \\",
    "command": "workbench.action.splitEditorDown"
  },

  // ============================================
  // VERTICAL SPLIT NAVIGATION (ctrl+a j / ctrl+a k)
  // ============================================
  // ctrl+a j - Focus editor group below
  {
    "key": "ctrl+a j",
    "command": "workbench.action.focusBelowGroup",
    "when": "editorFocus"
  },
  // ctrl+a k - Focus editor group above
  {
    "key": "ctrl+a k",
    "command": "workbench.action.focusAboveGroup",
    "when": "editorFocus"
  },

  // ============================================
  // FILE TAB NAVIGATION (ctrl+a n / ctrl+a p)
  // ============================================
  // ctrl+a n - Next file tab (right)
  {
    "key": "ctrl+a n",
    "command": "workbench.action.nextEditor"
  },
  // ctrl+a p - Previous file tab (left)
  {
    "key": "ctrl+a p",
    "command": "workbench.action.previousEditor"
  },

  // ============================================
  // CLOSE EDITORS (ctrl+a q / ctrl+a w)
  // ============================================
  // ctrl+a q - Close current editor
  {
    "key": "ctrl+a q",
    "command": "workbench.action.closeActiveEditor"
  },
  // ctrl+a w - Close ALL editors
  {
    "key": "ctrl+a w",
    "command": "workbench.action.closeAllEditors"
  },

  // ============================================
  // FILE OPERATIONS (ctrl+a r / ctrl+a c)
  // ============================================
  // ctrl+a r - Rename current file (reveals in explorer and triggers rename)
  {
    "key": "ctrl+a r",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.files.action.showActiveFileInExplorer",
        "renameFile"
      ]
    }
  },
  // ctrl+a c - Create new file in same directory as current file
  {
    "key": "ctrl+a c",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.files.action.showActiveFileInExplorer",
        "explorer.newFile"
      ]
    }
  },

  // ============================================
  // DISABLE TERMINAL KEYBINDINGS
  // ============================================
  {
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal"
  },
  {
    "key": "ctrl+shift+`",
    "command": "-workbench.action.terminal.new"
  },
  {
    "key": "cmd+j",
    "command": "-workbench.action.togglePanel"
  },
  {
    "key": "ctrl+shift+c",
    "command": "-workbench.action.terminal.openNativeConsole"
  },
  {
    "key": "cmd+`",
    "command": "-workbench.action.terminal.focusNext"
  },
  {
    "key": "cmd+shift+`",
    "command": "-workbench.action.terminal.focusPrevious"
  },

  // ============================================
  // PANE RESIZING (ctrl+a , / ctrl+a .)
  // , = grow leftward, . = grow rightward
  // ============================================

  // --- SIDEBAR (left) ---
  // . grows sidebar rightward
  {
    "key": "ctrl+a .",
    "command": "workbench.action.increaseViewSize",
    "when": "sideBarFocus || sideBarVisible && listFocus || explorerViewletFocus || filesExplorerFocus || searchViewletFocus || scmViewletFocus"
  },
  // , shrinks sidebar (retracts leftward)
  {
    "key": "ctrl+a ,",
    "command": "workbench.action.decreaseViewSize",
    "when": "sideBarFocus || sideBarVisible && listFocus || explorerViewletFocus || filesExplorerFocus || searchViewletFocus || scmViewletFocus"
  },

  // --- EDITOR (center) ---
  // . grows editor rightward
  {
    "key": "ctrl+a .",
    "command": "workbench.action.increaseViewSize",
    "when": "editorFocus"
  },
  // , shrinks editor
  {
    "key": "ctrl+a ,",
    "command": "workbench.action.decreaseViewSize",
    "when": "editorFocus"
  },

  // --- AUXILIARY BAR / AI CHAT (right) ---
  // , grows aux bar leftward
  {
    "key": "ctrl+a ,",
    "command": "workbench.action.increaseViewSize",
    "when": "auxiliaryBarFocus"
  },
  // . shrinks aux bar (retracts rightward)
  {
    "key": "ctrl+a .",
    "command": "workbench.action.decreaseViewSize",
    "when": "auxiliaryBarFocus"
  }
]
