{
  "window.commandCenter": 1,
  "vim.useSystemClipboard": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "git.decorations.enabled": false,
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "indent",
  "editor.lineNumbers": "relative",
  "typescript.inlayHints.parameterNames.enabled": "all",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.fontFamily": "'JetBrains Mono NL'",
  "color-highlight.markerType": "dot-before",
  "git.autofetch": true,
  "githubPullRequests.pullBranch": "never",
  "editor.largeFileOptimizations": false,
  "cursor.cpp.disabledLanguages": ["plaintext"],
  "markdown-preview-enhanced.breakOnSingleNewLine": true,
  "editor.accessibilitySupport": "off",
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": true
  },
  "git.openRepositoryInParentFolders": "never",
  "typescript.tsserver.watchOptions": "vscode",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "vim.commandLineModeKeyBindings": [],
  "workbench.colorTheme": "Catppuccin Mocha",
  "editor.fontWeight": "bold",
  "workbench.iconTheme": "material-icon-theme",
  "cursor.composer.shouldAllowCustomModes": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "json.schemaDownload.enable": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "cursorpyright.analysis.typeCheckingMode": "standard",
  "lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
  "lldb.launch.expressions": "native",
  "makefile.configureOnOpen": true,
  "vscode_vibrancy.theme": "Catppuccin Mocha",
  "vscode_vibrancy.opacity": 0.68,
  "vscode_vibrancy.imports": [
    "/Users/kalemedlin/Developer/dotfiles/cursor/vibrancy-custom.css"
  ],
  "vscode_vibrancy.type": "auto",
  "window.titleBarStyle": "custom",
  "window.nativeTabs": false,
  "catppuccin.accentColor": "mauve",
  "catppuccin.workbenchMode": "default",
  "catppuccin.customUIColors": {
    "mocha": {
      "editor.background": "#00000000",
      "editorGutter.background": "#00000000",
      "breadcrumb.background": "#00000000",
      "breadcrumbPicker.background": "#1e1e2e"
    }
  },
  "workbench.colorCustomizations": {
    "[Catppuccin Mocha]": {
      "editor.background": "#00000000",
      "editorGutter.background": "#00000000",
      "editorPane.background": "#00000000",
      "editorStickyScroll.background": "#1e1e2e",
      "editorStickyScrollHover.background": "#313244",
      "editor.lineHighlightBackground": "#00000000",
      "editor.lineHighlightBorder": "#00000000",
      "terminal.background": "#00000000",
      "sideBar.background": "#181825",
      "sideBarSectionHeader.background": "#181825",
      "activityBar.background": "#11111b",
      "statusBar.background": "#00000000",
      "statusBar.noFolderBackground": "#00000000",
      "statusBar.debuggingBackground": "#00000000",
      "titleBar.activeBackground": "#11111b",
      "titleBar.inactiveBackground": "#11111b",
      "panel.background": "#1e1e2e",
      "panelTitle.activeBorder": "#cba6f7",
      "tab.activeBackground": "#1e1e2e",
      "tab.inactiveBackground": "#181825",
      "tab.activeBorderTop": "#cba6f7",
      "editorGroupHeader.tabsBackground": "#181825",
      "breadcrumb.background": "#00000000",
      "minimap.background": "#1e1e2e80",
      "scrollbarSlider.background": "#31324480",
      "scrollbarSlider.hoverBackground": "#45475a80",
      "scrollbarSlider.activeBackground": "#585b7080",
      "list.activeSelectionBackground": "#45475a",
      "list.activeSelectionForeground": "#cdd6f4",
      "list.focusBackground": "#585b70",
      "list.focusForeground": "#cdd6f4",
      "list.focusOutline": "#cba6f7",
      "list.focusHighlightForeground": "#cdd6f4",
      "list.hoverBackground": "#313244",
      "list.hoverForeground": "#cdd6f4",
      "list.inactiveSelectionBackground": "#313244",
      "list.inactiveSelectionForeground": "#cdd6f4",
      "list.inactiveFocusBackground": "#45475a",
      "list.inactiveFocusOutline": "#89b4fa",
      "list.highlightForeground": "#cba6f7",
      "tree.indentGuidesStroke": "#45475a",
      "listFilterWidget.background": "#1e1e2e",
      "listFilterWidget.outline": "#cba6f7",
      "quickInput.background": "#1e1e2e",
      "dropdown.background": "#1e1e2e",
      "input.background": "#313244",
      "inputOption.activeBackground": "#45475a",
      "menu.background": "#1e1e2e",
      "menu.selectionBackground": "#45475a",
      "commandCenter.background": "#181825",
      "commandCenter.activeBackground": "#313244",
      "commandCenter.border": "#313244",
      "widget.shadow": "#11111b80"
    },
    "terminal.background": "#00000000"
  },
  "workbench.editor.showTabs": "single",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 1,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.sideBar.location": "right",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "terminal.integrated.gpuAcceleration": "off",
  "window.systemColorTheme": "dark",
  "window.autoDetectColorScheme": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3"
}

