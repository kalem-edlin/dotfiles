# Headless Brewfile — CLI tools only, no GUI apps/casks/fonts/vscode extensions
# Used by: make setup-headless

# Taps
tap "jesseduffield/lazydocker"
tap "supabase/tap"

# CLI tools
brew "actionlint"
brew "ast-grep"
brew "atac"
brew "bat"
brew "btop"
brew "cmake"
brew "cmatrix"
brew "cocoapods"
brew "docker"
brew "docker-compose"
brew "eza"
brew "fastlane"
brew "fd"
brew "fnm"
brew "fzf"
brew "gh"
brew "git"
brew "git-delta"
brew "git-filter-repo"
brew "git-lfs"
brew "glow"
brew "go"
brew "httpd"
brew "jq"
brew "jesseduffield/lazydocker/lazydocker"
brew "libpq"
brew "neovim"
brew "ninja"
brew "pipx"
brew "prettyping"
brew "python@3.12"
brew "pyenv"
brew "rbenv"
brew "uv"
brew "ripgrep"
brew "sl"
brew "sshs"
brew "stow"
brew "supabase/tap/supabase"
brew "swift"
brew "tmux"
brew "trash-cli", link: true
brew "tree"
brew "universal-ctags"
brew "watchman"
brew "webp"
brew "yarn"
brew "zippoxer/tap/recall"
brew "zoxide"
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-vi-mode"

# Networking
cask "tailscale-app"
