#!/usr/bin/env bash
# tmux-remote-workspaces command dispatcher.
#
# Usage: rw <handoff|handback|bg|request|open|switch|forget|reclaim|status|close|doctor> [args...]
#
# The unit of handoff is a directory root (a worktree or a plain folder);
# see docs/tasks/remote-owned-directories.md for the model and contracts.

set -uo pipefail

# Resolve through symlinks: rw is linked into ~/.local/bin, and sibling
# rw-*.sh scripts live next to the REAL file, not next to the symlink.
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  case "$SCRIPT_SOURCE" in
    /*) ;;
    *) SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

usage() {
  cat <<'EOF'
usage: rw <command> [args...]

commands:
  handoff --worker <alias> [--root <path>] [--pane <pane-id>] [--check-lfs]
          [--force-diverged] [--resolve overwrite|keep-both|abort]
      Hand a directory root (default: the pane's git worktree, or its
      directory) and every pane working inside it to <alias>. The remote
      copy becomes the only source of truth; the local copy stays, frozen.

  handback [--root <path>] [--pane <pane-id>] [--check-lfs]
           [--force-diverged] [--resolve overwrite|keep-both|abort]
           [--wait-idle [seconds]]
      Bring a remote root and all of its panes (and their agents) back.
      Refused while a remote agent is mid-turn; --wait-idle waits for it
      (default 300s).

  bg handoff [--worker <alias>] --pane <pane-id> [--root <path>] [--wait-idle <seconds>]
  bg handback --pane <pane-id> [--root <path>] [--wait-idle <seconds>]
      The same transfer in the background: checks, returns at once, then
      waits (default 600s) for the root's agents to finish their turn and
      runs handoff / handback detached. Progress shows in the status line;
      a conflict or failure opens a dialog. Log:
      ~/.local/state/tmux-remote-workspaces/logs/bg-<root_id>-<time>.log.
      --worker defaults to the only configured worker. --root names the
      root instead of resolving it from the pane.

  request handback
      On the remote side of a handed-off pane: ask the local side to hand
      this root back (sets the pane option @rw-request).

  open [--worker <alias>] [--root <path>] [--pane <pane-id>] [--dir <abs-path>]
      A new remote pane in a root that is already remote. No sync.
      Reattaches instead when the pane already has an endpoint.

  switch [--pane <pane-id>] --to <alias|local> [--dir <abs-path> | --dir-of <pane-id>] [--force]
      Move ONE pane to a remote or back to this machine, in the same
      directory: no files move, no ownership changes. An agent (claudef,
      pif) or an editor in it moves too; anything else is refused (exit 7).
      --dir-of uses another pane's live directory. --force (with --to
      local) releases a pane whose remote cannot be reached; what still
      runs there is stopped when that remote is next reached.

  forget <root> [--worker <alias>] [--force]
      The root is gone: delete every remote copy rw created of it, then
      close its remote panes. An unreachable remote is cleaned up on next
      contact. A root that is remote right now needs --force.

  reclaim [--force] <root>
      Take a remote root back from the frozen local copy while its remote
      is unreachable (probed first; --force skips the probe). Remote work
      since the handoff is not brought back.

  status [--json]
      Remote roots (owner, worker, panes, pending) and endpoints.

  close [--pane <pane-id> | --endpoint <id>] [--no-kill-pane] [--reason <text>]
      Close one remote pane and its remote session.

  doctor
      Diagnostics: local prerequisites, per-worker preflight, registry and
      live-pane consistency, clipboard/passthrough checks. Report only.

exit codes: 0 ok, 1 failure, 2 git history diverged, 3 agent CLI too old,
  5 files changed on the copy being overwritten (stdout lists
  conflict<TAB>path<TAB>changed|added|deleted; re-run with --resolve),
  6 remote unreachable, 7 root invalid or not in the required state
  (switch: refused), 64 usage.
EOF
}

[ $# -ge 1 ] || {
  usage >&2
  exit 64
}

command="$1"
shift

case "$command" in
  handoff) exec "$SCRIPT_DIR/rw-handoff.sh" "$@" ;;
  handback) exec "$SCRIPT_DIR/rw-handback.sh" "$@" ;;
  bg) exec "$SCRIPT_DIR/../libexec/rw-bg" "$@" ;;
  request) exec "$SCRIPT_DIR/../libexec/rw-request" "$@" ;;
  open) exec "$SCRIPT_DIR/rw-open.sh" "$@" ;;
  switch) exec "$SCRIPT_DIR/rw-switch.sh" "$@" ;;
  forget) exec "$SCRIPT_DIR/rw-forget.sh" "$@" ;;
  reclaim) exec "$SCRIPT_DIR/rw-reclaim.sh" "$@" ;;
  status) exec "$SCRIPT_DIR/rw-status.sh" "$@" ;;
  close) exec "$SCRIPT_DIR/rw-close.sh" "$@" ;;
  doctor) exec "$SCRIPT_DIR/rw-doctor.sh" "$@" ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  *)
    printf 'rw: unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 64
    ;;
esac
