#!/usr/bin/env bash
# libexec/sync/handoff -- workspace transfer core for one directory root.
#
# Two channels move a root between the focus machine and a worker:
#   - the git channel (git roots only): unpushed commits as a bundle,
#     staged and unstaged binary patches, untracked (non-ignored) files as a
#     tar, referenced LFS content -- with a destination backup and a
#     divergence check before a managed destination is ever overwritten,
#     and deletion of untracked files the owner no longer has;
#   - the rsync channel: everything the git channel ignores. For a git root
#     that is exactly the gitignored set (.env*, node_modules, build output);
#     for a plain root it is the whole tree. Apple openrsync (protocol 29)
#     over the same ssh alias, relative paths, delete semantics,
#     COPYFILE_DISABLE=1.
#
# Before the destination copy is overwritten it is compared to its stored
# manifest (the manifest gate, owner wins): unchanged is silent; a change
# exits 5 listing `conflict\t<relpath>\t<changed|added|deleted>` on stdout
# unless --resolve says what to do. keep-both renames each losing file to
# `<file>.local-<YYYYMMDD-HHMMSS>` before the transfer.
#
# Usage:
#   handoff sync --direction handoff|handback|return \
#     --source-path <path> --dest-path <path> \
#     --dest-mode local|ssh|custom \
#       [--dest-worker <alias>]                  # ssh mode
#       [--dest-exec-bin <bin> --dest-exec-arg <arg> ...]  # custom mode
#     [--pull]                                   # see below
#     [--kind git|plain]                         # default: detected
#     [--dest-manifest <file>]                   # enables the manifest gate
#     [--resolve overwrite|keep-both|abort]
#     [--manifest-out <dir>]                     # writes source.tsv, dest.tsv
#     [--endpoint <id> | --state-file <path>]    # generation/divergence state
#     [--token <name>]                           # backup/staging directory name
#     [--backup-root <path>] [--staging-root <path>]
#     [--check-lfs] [--force-diverged]
#
#   handoff fingerprint --path <path> --dest-mode local|ssh|custom [...]
#   handoff manifest --path <path> [--kind git|plain] --dest-mode local|ssh|custom [...]
#
# This process always runs on ONE of the two hosts involved and reaches the
# OTHER through the --dest-mode/--dest-worker/--dest-exec-* exec wrapper --
# those flags always describe "how to reach the far side", never which of
# source/dest that is. By default (push, used by `rw handoff`) the far side
# is the destination: --source-path is read directly and --dest-path is
# reached over the wrapper (the worker). Pass --pull (used by `rw handback`,
# which also runs on the focus machine) to invert that. Every other flag and
# the whole correctness model are identical either way -- only which side is
# "near" (direct) vs "far" (wrapper) changes. rsync reaches the far side
# with `-e "<ssh> -o BatchMode=yes ..."` in ssh mode and as a plain local
# path in local/custom mode (same-host tests).
#
# See ./README.md for the full wire format and exit code table.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

rw_need_jq

usage() {
  cat <<'EOF'
usage: handoff <command> [args...]

commands:
  sync --direction handoff|handback --source-path <path> --dest-path <path>
       --dest-mode local|ssh|custom [--dest-worker <alias>]
       [--dest-exec-bin <bin>] [--dest-exec-arg <arg>]... [--pull]
       [--kind git|plain] [--dest-manifest <file>]
       [--resolve overwrite|keep-both|abort] [--manifest-out <dir>]
       [--endpoint <id> | --state-file <path>] [--token <name>]
       [--backup-root <path>] [--staging-root <path>]
       [--check-lfs] [--force-diverged]

  fingerprint --path <path>
       --dest-mode local|ssh|custom [--dest-worker <alias>] [...]

  manifest --path <path> [--kind git|plain]
       --dest-mode local|ssh|custom [--dest-worker <alias>] [...]

Exit codes: 0 ok, 2 diverged (aborted, nothing touched), 3 transfer verify
failed (destination untouched), 4 post-apply verify failed (destination
partially applied -- see backup), 5 manifest conflict (stdout lists
conflict<TAB>path<TAB>changed|added|deleted; nothing touched), 64 usage.
EOF
}

# ---------------------------------------------------------------------------
# Shared arg-parsing for the destination exec wrapper.
# ---------------------------------------------------------------------------

dest_mode=""
dest_worker=""
dest_exec_bin=""
dest_exec_args=()

configure_dest_exec() {
  case "$dest_mode" in
    ssh)
      [ -n "$dest_worker" ] || rw_die "handoff: --dest-worker is required for --dest-mode ssh" 64
      rw_sync_set_dest_exec_ssh "$dest_worker"
      ;;
    local)
      rw_sync_set_dest_exec_local
      ;;
    custom)
      [ -n "$dest_exec_bin" ] || rw_die "handoff: --dest-exec-bin is required for --dest-mode custom" 64
      rw_sync_set_dest_exec_custom "$dest_exec_bin" "${dest_exec_args[@]+"${dest_exec_args[@]}"}"
      ;;
    '') rw_die "handoff: --dest-mode is required (local|ssh|custom)" 64 ;;
    *) rw_die "handoff: unknown --dest-mode: $dest_mode" 64 ;;
  esac
}

# Far-side path as rsync must spell it: ssh mode prefixes the alias and
# shell-escapes the path (the remote shell parses it; openrsync has no
# --protect-args). Local/custom modes use the plain path.
rsync_far_path() {
  if [ "$dest_mode" = "ssh" ]; then
    printf '%s:%q' "$dest_worker" "$1"
  else
    printf '%s' "$1"
  fi
}

# ---------------------------------------------------------------------------
# fingerprint / manifest subcommands -- thin CLI wrappers, useful standalone
# for tests and for status/doctor-style introspection.
# ---------------------------------------------------------------------------

cmd_fingerprint() {
  local path=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --path) path="${2:?}"; shift 2 ;;
      --dest-mode) dest_mode="${2:?}"; shift 2 ;;
      --dest-worker) dest_worker="${2:?}"; shift 2 ;;
      --dest-exec-bin) dest_exec_bin="${2:?}"; shift 2 ;;
      --dest-exec-arg) dest_exec_args+=("${2:?}"); shift 2 ;;
      *) rw_die "handoff fingerprint: unknown argument: $1" 64 ;;
    esac
  done
  [ -n "$path" ] || rw_die "handoff fingerprint: --path is required" 64
  configure_dest_exec
  rw_sync_fingerprint_dest "$path"
}

cmd_manifest() {
  local path="" kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --path) path="${2:?}"; shift 2 ;;
      --kind) kind="${2:?}"; shift 2 ;;
      --dest-mode) dest_mode="${2:?}"; shift 2 ;;
      --dest-worker) dest_worker="${2:?}"; shift 2 ;;
      --dest-exec-bin) dest_exec_bin="${2:?}"; shift 2 ;;
      --dest-exec-arg) dest_exec_args+=("${2:?}"); shift 2 ;;
      *) rw_die "handoff manifest: unknown argument: $1" 64 ;;
    esac
  done
  [ -n "$path" ] || rw_die "handoff manifest: --path is required" 64
  configure_dest_exec
  if [ -z "$kind" ]; then
    kind="$(rw_sync_dest_run "$(rw_sync_kind_probe "$path")" 2>/dev/null | tr -d '\r\n')"
    [ "$kind" = "git" ] || kind="plain"
  fi
  rw_sync_manifest_via rw_sync_dest_exec_script "$path" "$kind"
  if [ "$kind" = "git" ]; then
    printf '#git\t%s\n' "$(rw_sync_fingerprint_dest "$path" | tr -d '\r\n')"
  fi
}

# ---------------------------------------------------------------------------
# sync subcommand
# ---------------------------------------------------------------------------

cmd_sync() {
  local direction="" source_path="" dest_path="" pull="false"
  local endpoint_id="" state_file="" kind="" dest_manifest="" dest_manifest_set="false"
  local resolve="" manifest_out="" token=""
  # Local-machine defaults (this process's own state dir, override-aware for
  # tests) -- correct for a pull, where the destination being backed
  # up/staged is this same (focus) machine. A caller writing to a remote
  # worker (rw-handoff.sh's push) always passes both flags, computed from
  # the worker's own queried $HOME (see rw_state_dir_at()).
  local backup_root staging_root
  backup_root="$(rw_state_dir)/handoff-backups"
  staging_root="$(rw_state_dir)/handoff-staging"
  local check_lfs="false" force_diverged="false"

  while [ $# -gt 0 ]; do
    case "$1" in
      --direction) direction="${2:?}"; shift 2 ;;
      --source-path) source_path="${2:?}"; shift 2 ;;
      --dest-path) dest_path="${2:?}"; shift 2 ;;
      --dest-mode) dest_mode="${2:?}"; shift 2 ;;
      --dest-worker) dest_worker="${2:?}"; shift 2 ;;
      --dest-exec-bin) dest_exec_bin="${2:?}"; shift 2 ;;
      --dest-exec-arg) dest_exec_args+=("${2:?}"); shift 2 ;;
      --pull) pull="true"; shift ;;
      --kind) kind="${2:?}"; shift 2 ;;
      --dest-manifest) dest_manifest="${2:?}"; dest_manifest_set="true"; shift 2 ;;
      --resolve) resolve="${2:?}"; shift 2 ;;
      --manifest-out) manifest_out="${2:?}"; shift 2 ;;
      --endpoint) endpoint_id="${2:?}"; shift 2 ;;
      --state-file) state_file="${2:?}"; shift 2 ;;
      --token) token="${2:?}"; shift 2 ;;
      --backup-root) backup_root="${2:?}"; shift 2 ;;
      --staging-root) staging_root="${2:?}"; shift 2 ;;
      --check-lfs) check_lfs="true"; shift ;;
      --force-diverged) force_diverged="true"; shift ;;
      *) rw_die "handoff sync: unknown argument: $1" 64 ;;
    esac
  done

  case "$direction" in
    handoff | handback | return) : ;;
    *) rw_die "handoff sync: --direction must be 'handoff' or 'handback'" 64 ;;
  esac
  case "$kind" in '' | git | plain) : ;; *) rw_die "handoff sync: --kind must be git or plain" 64 ;; esac
  case "$resolve" in '' | overwrite | keep-both | abort) : ;; *) rw_die "handoff sync: --resolve must be overwrite, keep-both or abort" 64 ;; esac
  [ -n "$source_path" ] || rw_die "handoff sync: --source-path is required" 64
  [ -n "$dest_path" ] || rw_die "handoff sync: --dest-path is required" 64
  configure_dest_exec

  # --- near/far dispatch ----------------------------------------------------
  # "near" = direct on this process's own filesystem; "far" = over the
  # configured exec wrapper. Push (default): source is near, dest is far.
  # Pull: inverted. Every call site below goes through these four functions
  # (some only indirectly, by name).
  # shellcheck disable=SC2329
  exec_source() {
    if [ "$pull" != "true" ]; then bash -c "$1"; else rw_sync_dest_run "$1"; fi
  }
  # shellcheck disable=SC2329
  exec_source_script() {
    if [ "$pull" != "true" ]; then bash -s <"$1"; else rw_sync_dest_exec_script "$1"; fi
  }
  exec_dest() {
    if [ "$pull" != "true" ]; then rw_sync_dest_run "$1"; else bash -c "$1"; fi
  }
  exec_dest_script() {
    if [ "$pull" != "true" ]; then rw_sync_dest_exec_script "$1"; else bash -s <"$1"; fi
  }

  if [ "$pull" != "true" ]; then
    source_path="$(cd "$source_path" 2>/dev/null && pwd -P)" || rw_die "handoff sync: --source-path does not exist: $source_path" 64
  else
    dest_path="$(rw_physical_path "$dest_path")"
  fi
  local sq_source sq_dest
  sq_source="$(rw_sync_shquote "$source_path")"
  sq_dest="$(rw_sync_shquote "$dest_path")"

  exec_source "[ -d $sq_source ]" >/dev/null 2>&1 ||
    rw_die "handoff sync: --source-path does not exist: $source_path" 64

  # A git root is a worktree TOPLEVEL; anything else travels as plain.
  if [ -z "$kind" ]; then
    kind="$(exec_source "$(rw_sync_kind_probe "$source_path")" 2>/dev/null | tr -d '\r\n')"
    [ "$kind" = "git" ] || kind="plain"
  elif [ "$kind" = "git" ]; then
    exec_source "git -C $sq_source rev-parse --is-inside-work-tree" >/dev/null 2>&1 ||
      rw_die "handoff sync: --source-path is not a git worktree: $source_path" 64
  fi

  # Submodules are not carried by either channel (a gitlink is just a sha;
  # the checkout inside it is its own repository). Refuse before anything is
  # touched rather than leave an empty or half-applied submodule behind.
  if [ "$kind" = "git" ]; then
    # shellcheck disable=SC2016 # expands on the side that runs it
    local sm_probe='git ls-files --stage 2>/dev/null | awk '"'"'$1 == "160000" { print $4; exit }'"'"''
    local sm_src sm_dst
    sm_src="$(exec_source "cd $sq_source 2>/dev/null && $sm_probe" 2>/dev/null | tr -d '\r')"
    sm_dst="$(exec_dest "cd $sq_dest 2>/dev/null && $sm_probe" 2>/dev/null | tr -d '\r')"
    if [ -n "$sm_src$sm_dst" ]; then
      rw_warn "handoff sync: '${sm_src:-$sm_dst}' is a git submodule; roots with submodules cannot be handed off (their content would not travel). Nothing was touched."
      return 1
    fi
  fi

  local start_ts
  start_ts="$(rw_now_epoch)"

  local backup_token="$token"
  [ -n "$backup_token" ] || backup_token="${endpoint_id:-}"
  if [ -z "$backup_token" ] && [ -n "$state_file" ]; then
    backup_token="$(basename "$state_file")"
    backup_token="${backup_token%.json}"
  fi
  [ -n "$backup_token" ] || backup_token="adhoc-$(printf '%s' "$dest_path" | rw_sync_stable_slug)"

  # Deliberately NOT `local`: an EXIT trap fires after this function has
  # already returned, so the variable it references must still be in scope.
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/rw-handoff.XXXXXX")"
  # Cleanup only the LOCAL scratch dir on exit. Never touch source or dest.
  trap 'rm -rf "$work_dir"' EXIT

  local snap_dir="$work_dir/snapshot"
  mkdir -p "$snap_dir"
  local protect_list="$work_dir/protect.list"
  : >"$protect_list"

  local branch="" head_commit="" detached="false" source_fingerprint=""
  local bundle_present="false" staged_present="false" unstaged_present="false" lfs_present="false"
  local untracked_list="$work_dir/untracked.list"
  : >"$untracked_list"

  # =========================================================================
  # Git channel, part 1: capture (read-only against the source).
  # =========================================================================
  if [ "$kind" = "git" ]; then
    # NOTE: plain `git rev-parse HEAD` / `--abbrev-ref HEAD` echo the literal
    # ref name to STDOUT even when it cannot be resolved (unborn branch, empty
    # repo) while exiting nonzero. `--verify --quiet 'HEAD^{commit}'` prints
    # only on success; symbolic-ref fails silently with -q when detached.
    branch="$(exec_source "git -C $sq_source symbolic-ref --short -q HEAD 2>/dev/null || echo HEAD")"
    head_commit="$(exec_source "git -C $sq_source rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null || true")"
    [ -n "$head_commit" ] || rw_die "handoff sync: --source-path has no commits (empty repo) -- nothing to hand off" 64
    [ "$branch" = "HEAD" ] && detached="true"

    rw_warn "handoff: capturing source state at $source_path ($branch @ ${head_commit:0:12})"

    # Ask the destination what it already has, so the bundle only carries
    # what it lacks (unpushed commits travel without touching origin).
    local dest_head
    dest_head="$(exec_dest "git -C $sq_dest rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null || true" 2>/dev/null || true)"
    dest_head="$(printf '%s' "$dest_head" | tr -d '\r\n')"

    # NOTE: "HEAD" (a ref), not the bare sha -- `git bundle create` refuses a
    # bare object id ("Refusing to create empty bundle").
    local bundle_range="HEAD"
    if [ -n "$dest_head" ] && exec_source "git -C $sq_source cat-file -e '${dest_head}^{commit}'" 2>/dev/null; then
      bundle_range="${dest_head}..HEAD"
    fi
    local commit_count
    commit_count="$(exec_source "git -C $sq_source rev-list --count $bundle_range 2>/dev/null || echo 0")"
    if [ "${commit_count:-0}" -gt 0 ]; then
      if exec_source "git -C $sq_source bundle create - $bundle_range" >"$snap_dir/bundle.git" 2>"$work_dir/bundle.log"; then
        bundle_present="true"
      else
        rw_die "handoff sync: failed to create git bundle ($bundle_range): $(cat "$work_dir/bundle.log")" 1
      fi
    fi

    exec_source "git -C $sq_source diff --binary -M --cached" >"$snap_dir/staged.patch"
    exec_source "git -C $sq_source diff --binary -M" >"$snap_dir/unstaged.patch"
    [ -s "$snap_dir/staged.patch" ] && staged_present="true"
    [ -s "$snap_dir/unstaged.patch" ] && unstaged_present="true"

    # Keep-both copies stay on the side they were made on: never carried.
    exec_source "git -C $sq_source ls-files --others --exclude-standard -z" |
      tr '\0' '\n' | grep -Ev "$RW_SYNC_KEEP_BOTH_ERE" | tr '\n' '\0' >"$untracked_list"
    # COPYFILE_DISABLE=1: on macOS, bsdtar otherwise embeds AppleDouble
    # (._*) companions for files carrying xattrs; a Linux destination's GNU
    # tar materializes those as literal ._* files.
    exec_source "COPYFILE_DISABLE=1 tar -C $sq_source --null -T - -cf -" <"$untracked_list" >"$snap_dir/untracked.tar" 2>"$work_dir/untracked.log" ||
      rw_die "handoff sync: failed to archive untracked files: $(cat "$work_dir/untracked.log")" 1
    # Newline list of the source's untracked files: the apply step deletes
    # destination untracked files that are absent here (owner wins).
    tr '\0' '\n' <"$untracked_list" >"$snap_dir/untracked.list"

    if [ "$check_lfs" = "true" ] && exec_source "git -C $sq_source lfs env" >/dev/null 2>&1; then
      exec_source "git -C $sq_source lfs pull" >"$work_dir/lfs.log" 2>&1 || true
      if exec_source "[ -d $sq_source/.git/lfs/objects ] && [ -n \"\$(find $sq_source/.git/lfs/objects -type f -print -quit 2>/dev/null)\" ]" 2>/dev/null; then
        if exec_source "COPYFILE_DISABLE=1 tar -C $sq_source/.git/lfs/objects -cf - ." >"$snap_dir/lfs-snapshot.tar" 2>"$work_dir/lfs-tar.log"; then
          lfs_present="true"
        fi
      fi
    fi

    source_fingerprint="$(rw_sync_fingerprint_via exec_source_script "$source_path")"
    source_fingerprint="$(printf '%s' "$source_fingerprint" | tr -d '\r\n')"
  fi

  # --- generation / divergence state (git roots) ----------------------------
  # Baseline: the `#git` row of the destination's stored manifest when the
  # caller passed one, else the endpoint/state-file generation record.
  local gen_json prev_generation prev_fingerprint next_generation baseline_fp=""
  if [ -n "$endpoint_id" ]; then
    gen_json="$(rw_sync_gen_read_endpoint "$endpoint_id")"
  elif [ -n "$state_file" ]; then
    gen_json="$(rw_sync_gen_read_statefile "$state_file")"
  else
    gen_json='{"generation":0,"fingerprint":null}'
  fi
  prev_generation="$(printf '%s' "$gen_json" | jq -r '.generation // 0')"
  prev_fingerprint="$(printf '%s' "$gen_json" | jq -r '.fingerprint // empty')"
  next_generation=$((prev_generation + 1))
  if [ "$dest_manifest_set" = "true" ]; then
    baseline_fp="$(rw_sync_manifest_git_fp "$dest_manifest")"
  fi
  if [ -z "$baseline_fp" ] && [ "$prev_generation" -gt 0 ]; then
    baseline_fp="$prev_fingerprint"
  fi

  # In-flight marker: written on the destination right before this sync
  # starts modifying it, removed when it finishes. A run interrupted after
  # that point leaves the destination in a state of OUR making, which a
  # retry from the same baseline may overwrite (it converges instead of
  # reporting divergence).
  local inflight_file="$staging_root/$backup_token/inflight"
  if [ "$kind" = "git" ] && [ "$force_diverged" != "true" ]; then
    local dest_fp_now
    dest_fp_now="$(rw_sync_fingerprint_via exec_dest_script "$dest_path" 2>/dev/null || echo EMPTY)"
    dest_fp_now="$(printf '%s' "$dest_fp_now" | tr -d '\r\n')"
    # EMPTY: the destination is gone or not a repository -- nothing there can
    # be lost. Equal to the incoming source: nothing would change.
    if [ "$dest_fp_now" != "EMPTY" ] && [ "$dest_fp_now" != "$source_fingerprint" ] &&
      [ "$dest_fp_now" != "$baseline_fp" ]; then
      local inflight_mark
      inflight_mark="$(exec_dest "cat $(rw_sync_shquote "$inflight_file") 2>/dev/null" 2>/dev/null | tr -d '\r\n')"
      if [ -n "$inflight_mark" ] && [ "$inflight_mark" = "${baseline_fp:-none}" ]; then
        rw_warn "handoff sync: resuming an interrupted sync of '$dest_path'."
      else
        duration_ms="$(rw_elapsed_ms "$start_ts")"
        if [ -z "$baseline_fp" ]; then
          rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" \
            "diverged: existing destination repository with no sync record"
          rw_warn "handoff sync: '$dest_path' is an existing repository whose state differs from the source, and there is no record of an earlier sync to compare it with."
        else
          rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" \
            "diverged: destination git state changed since it was last synchronized"
          rw_warn "handoff sync: the destination's git state (commits, staged/unstaged changes, untracked file list) changed since it was last synchronized."
        fi
        rw_warn "Neither side has been touched. Reconcile manually (inspect '$dest_path'), or re-run with --force-diverged to overwrite it (a destination backup is still taken first)."
        return 2
      fi
    fi
  fi

  # =========================================================================
  # Manifest gate (owner wins): compare the copy about to be overwritten
  # with its stored manifest. Without a stored manifest the baseline is the
  # incoming source: only files that would really be replaced or deleted
  # count.
  # =========================================================================
  local renamed_count=0 overwritten_count=0
  local dest_now="$work_dir/dest-now.tsv" src_now="$work_dir/source-now.tsv"
  rw_sync_manifest_via exec_dest_script "$dest_path" "$kind" >"$dest_now" 2>/dev/null || : >"$dest_now"
  rw_sync_manifest_via exec_source_script "$source_path" "$kind" >"$src_now" 2>/dev/null || : >"$src_now"
  # A plain owner copy with no files at all would empty the other copy:
  # almost always a mistake (wrong mount, wiped directory), so it needs an
  # explicit overwrite.
  if [ "$kind" = "plain" ] && [ ! -s "$src_now" ] && [ -s "$dest_now" ] && [ "$resolve" != "overwrite" ]; then
    rw_warn "handoff sync: '$source_path' has no files, so this would delete all $(wc -l <"$dest_now" | tr -d ' ') file(s) in '$dest_path'. Nothing was touched; re-run with --resolve overwrite if that is intended."
    return 1
  fi
  if [ "$dest_manifest_set" = "true" ]; then
    local conflicts="$work_dir/conflicts.tsv"
    if [ -s "$dest_manifest" ]; then
      # Changed since it was stored AND different from what the transfer
      # would write: only those files lose something.
      rw_sync_manifest_diff "$dest_manifest" "$dest_now" | rw_sync_conflicts_at_risk "$dest_now" "$src_now" >"$conflicts"
    else
      rw_sync_manifest_diff "$src_now" "$dest_now" --no-deleted >"$conflicts"
    fi
    if [ -s "$conflicts" ]; then
      case "$resolve" in
        '' | abort)
          duration_ms="$(rw_elapsed_ms "$start_ts")"
          rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" \
            "manifest_conflict:$(wc -l <"$conflicts" | tr -d ' ')"
          rw_warn "handoff sync: $(wc -l <"$conflicts" | tr -d ' ') file(s) in '$dest_path' changed since it was last synchronized; nothing was touched. Re-run with --resolve overwrite|keep-both|abort."
          cat "$conflicts"
          return 5
          ;;
        overwrite)
          overwritten_count="$(wc -l <"$conflicts" | tr -d ' ')"
          rw_warn "handoff sync: overwriting $overwritten_count changed file(s) in '$dest_path' (--resolve overwrite)."
          ;;
        keep-both)
          local kb_script="$work_dir/keep-both.sh" kb_stamp
          kb_stamp="$(date '+%Y%m%d-%H%M%S')"
          {
            printf 'set -u\n'
            printf 'cd %q || exit 1\n' "$dest_path"
            # shellcheck disable=SC2016 # $1 belongs to the generated script
            printf '__rw_kb() { if [ -e "$1" ] || [ -L "$1" ]; then mv -f -- "$1" "$1.local-%s" && printf "%%s\\n" "$1.local-%s"; fi; }\n' "$kb_stamp" "$kb_stamp"
            awk -F '\t' '$3 != "deleted" { print $2 }' "$conflicts" | while IFS= read -r kb_path; do
              printf '__rw_kb %q\n' "$kb_path"
            done
          } >"$kb_script"
          if ! exec_dest_script "$kb_script" >"$protect_list" 2>"$work_dir/keep-both.err"; then
            rw_warn "handoff sync: keep-both rename failed on the destination: $(cat "$work_dir/keep-both.err")"
            return 1
          fi
          renamed_count="$(wc -l <"$protect_list" | tr -d ' ')"
          rw_warn "handoff sync: kept $renamed_count destination file(s) as <file>.local-$kb_stamp (--resolve keep-both)."
          ;;
      esac
    fi
  fi

  # =========================================================================
  # Git channel, part 2: stage, back up, apply, verify.
  # =========================================================================
  local backup_dir="" dest_fp_after=""
  exec_dest "mkdir -p $(rw_sync_shquote "$staging_root/$backup_token") && printf '%s\n' $(rw_sync_shquote "${baseline_fp:-none}") >$(rw_sync_shquote "$inflight_file")" >/dev/null 2>&1 || true
  if [ "$kind" = "git" ]; then
    cp "$protect_list" "$snap_dir/protect.list"
    local untracked_count
    untracked_count="$(tr -cd '\0' <"$untracked_list" | wc -c | tr -d ' ')"

    jq -nc \
      --arg direction "$direction" \
      --arg branch "$branch" \
      --arg head_commit "$head_commit" \
      --argjson detached "$detached" \
      --argjson bundle_present "$bundle_present" \
      --argjson staged_present "$staged_present" \
      --argjson unstaged_present "$unstaged_present" \
      --argjson untracked_count "${untracked_count:-0}" \
      --argjson lfs_present "$lfs_present" \
      --arg source_fingerprint "$source_fingerprint" \
      --arg source_path "$source_path" \
      --arg dest_path "$dest_path" \
      --arg created_at "$(rw_now_iso)" \
      '{format_version: 2, direction: $direction, branch: $branch, head_commit: $head_commit,
        detached: $detached, bundle_present: $bundle_present, staged_present: $staged_present,
        unstaged_present: $unstaged_present, untracked_count: $untracked_count,
        lfs_present: $lfs_present,
        source_fingerprint: $source_fingerprint, source_path: $source_path, dest_path: $dest_path,
        created_at: $created_at}' >"$snap_dir/meta.json"

    # --- transfer into a destination STAGING dir (never the live workspace)
    local staging_ts
    staging_ts="$(date +%s)"
    local staging_dir="$staging_root/$backup_token/g$next_generation-$staging_ts"
    local mkstage="$work_dir/mkstage.sh"
    {
      printf 'set -uo pipefail\n'
      printf 'mkdir -p %q\n' "$staging_dir"
    } >"$mkstage"
    exec_dest_script "$mkstage" || rw_die "handoff sync: could not prepare staging directory on destination" 1

    if ! tar -C "$snap_dir" -cf - . | exec_dest "tar -C $(rw_sync_shquote "$staging_dir") -xf -"; then
      duration_ms="$(rw_elapsed_ms "$start_ts")"
      rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "transfer_interrupted"
      rw_warn "handoff sync: transfer to destination was interrupted. The live destination at '$dest_path' was never touched; the source at '$source_path' was never touched. Partial staging data (if any) is inert at '$staging_dir' on the destination and safe to delete."
      return 3
    fi

    # --- verify staging landed intact ---------------------------------------
    local remote_meta remote_head
    remote_meta="$(exec_dest "cat $(rw_sync_shquote "$staging_dir/meta.json") 2>/dev/null || true")"
    remote_head="$(printf '%s' "$remote_meta" | jq -r '.head_commit // empty' 2>/dev/null || true)"
    if [ "$remote_head" != "$head_commit" ]; then
      duration_ms="$(rw_elapsed_ms "$start_ts")"
      rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "staging_verify_failed"
      rw_warn "handoff sync: staged transfer at '$staging_dir' on the destination failed verification (meta.json missing or head_commit mismatch). The live destination at '$dest_path' was never touched; the source was never touched."
      return 3
    fi

    # --- destination backup (only if dest already has committed content) ----
    local dest_is_repo
    dest_is_repo="$(exec_dest "git -C $sq_dest rev-parse --is-inside-work-tree 2>/dev/null || echo false")"
    dest_is_repo="$(printf '%s' "$dest_is_repo" | tr -d '\r\n')"
    if [ "$dest_is_repo" = "true" ]; then
      backup_dir="$backup_root/$backup_token/$next_generation-$staging_ts"
      local bkscript="$work_dir/backup.sh"
      {
        printf 'set -uo pipefail\n'
        printf '__RW_BK_PATH=%q\n' "$dest_path"
        printf '__RW_BK_DIR=%q\n' "$backup_dir"
        cat <<'EOS'
mkdir -p "$__RW_BK_DIR"
if git -C "$__RW_BK_PATH" rev-parse HEAD >/dev/null 2>&1; then
  git -C "$__RW_BK_PATH" bundle create "$__RW_BK_DIR/bundle.git" HEAD >/dev/null 2>&1 || true
  git -C "$__RW_BK_PATH" rev-parse HEAD >"$__RW_BK_DIR/head.txt"
  git -C "$__RW_BK_PATH" rev-parse --abbrev-ref HEAD >"$__RW_BK_DIR/branch.txt"
fi
git -C "$__RW_BK_PATH" diff --binary -M --cached >"$__RW_BK_DIR/staged.patch" 2>/dev/null || : >"$__RW_BK_DIR/staged.patch"
git -C "$__RW_BK_PATH" diff --binary -M >"$__RW_BK_DIR/unstaged.patch" 2>/dev/null || : >"$__RW_BK_DIR/unstaged.patch"
__rw_bk_list="$(mktemp "${TMPDIR:-/tmp}/rw-bk-list.XXXXXX")"
git -C "$__RW_BK_PATH" ls-files --others --exclude-standard -z >"$__rw_bk_list" 2>/dev/null || : >"$__rw_bk_list"
COPYFILE_DISABLE=1 tar -C "$__RW_BK_PATH" --null -T "$__rw_bk_list" -cf "$__RW_BK_DIR/untracked.tar"
rm -f "$__rw_bk_list"
printf 'backup-ok\n'
EOS
      } >"$bkscript"
      local bkout
      bkout="$(exec_dest_script "$bkscript" 2>"$work_dir/backup.err")"
      if [ "$bkout" != "backup-ok" ]; then
        duration_ms="$(rw_elapsed_ms "$start_ts")"
        rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "backup_failed"
        rw_warn "handoff sync: could not create the pre-overwrite destination backup ($(cat "$work_dir/backup.err" 2>/dev/null)); refusing to overwrite '$dest_path'. Source and (previous) destination content are both untouched."
        return 1
      fi
      rw_warn "handoff: backed up destination's prior state to $backup_dir on the destination host"
    fi

    # --- apply: staging -> live destination ---------------------------------
    local apply_script="$work_dir/apply.sh"
    {
      printf 'set -uo pipefail\n'
      printf '__RW_A_DEST=%q\n' "$dest_path"
      printf '__RW_A_STAGE=%q\n' "$staging_dir"
      printf '__RW_A_BRANCH=%q\n' "$branch"
      printf '__RW_A_HEAD=%q\n' "$head_commit"
      printf '__RW_A_DETACHED=%q\n' "$detached"
      printf '__RW_A_BUNDLE=%q\n' "$bundle_present"
      printf '__RW_A_STAGED=%q\n' "$staged_present"
      printf '__RW_A_UNSTAGED=%q\n' "$unstaged_present"
      printf '__RW_A_LFS=%q\n' "$lfs_present"
      printf '__RW_A_REF=%q\n' "refs/rw-incoming/$(printf '%s' "$backup_token" | tr -c 'A-Za-z0-9_-' '_')"
      cat <<'EOS'
mkdir -p "$__RW_A_DEST"
if ! git -C "$__RW_A_DEST" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git init -q "$__RW_A_DEST"
fi

if [ "$__RW_A_LFS" = "true" ]; then
  mkdir -p "$__RW_A_DEST/.git/lfs/objects"
  tar -C "$__RW_A_DEST/.git/lfs/objects" -xf "$__RW_A_STAGE/lfs-snapshot.tar"
fi

# -f/--force: the whole point of reaching this step is an intentional
# overwrite of the destination's working tree (a recoverable backup was
# already taken when the destination was a managed repo).
# The bundle lands on a per-root ref (linked worktrees share refs/, so a
# shared name would let two concurrent hand-backs see each other's
# commits), and the checkout names the captured sha, never the ref.
if [ "$__RW_A_BUNDLE" = "true" ]; then
  git -C "$__RW_A_DEST" fetch -q --no-tags "$__RW_A_STAGE/bundle.git" "+HEAD:$__RW_A_REF" || exit 21
fi
[ "$(git -C "$__RW_A_DEST" rev-parse --verify -q "$__RW_A_HEAD^{commit}")" = "$__RW_A_HEAD" ] || exit 21
if [ "$__RW_A_DETACHED" = "true" ]; then
  git -C "$__RW_A_DEST" checkout -f -q --detach "$__RW_A_HEAD" || exit 22
else
  git -C "$__RW_A_DEST" checkout -f -q -B "$__RW_A_BRANCH" "$__RW_A_HEAD" || exit 22
fi
[ "$__RW_A_BUNDLE" = "true" ] && { git -C "$__RW_A_DEST" update-ref -d "$__RW_A_REF" || true; }

if [ "$__RW_A_STAGED" = "true" ]; then
  # --index (not --cached): a staged rename/add/delete must land in BOTH
  # the index and the working tree.
  git -C "$__RW_A_DEST" apply --binary --index "$__RW_A_STAGE/staged.patch" || exit 23
fi
if [ "$__RW_A_UNSTAGED" = "true" ]; then
  git -C "$__RW_A_DEST" apply --binary "$__RW_A_STAGE/unstaged.patch" || exit 24
fi

tar -C "$__RW_A_DEST" -xf "$__RW_A_STAGE/untracked.tar" || exit 25

# Owner wins for untracked files too: delete destination untracked
# (non-ignored) files the source no longer has, except keep-both copies
# (<file>.local-YYYYMMDD-HHMMSS), which no sync ever deletes. Newline-separated lists; bash 3.2-safe (no comm -z on macOS).
__rw_dest_list="$(mktemp "${TMPDIR:-/tmp}/rw-apply-dest.XXXXXX")"
__rw_keep_list="$(mktemp "${TMPDIR:-/tmp}/rw-apply-keep.XXXXXX")"
git -C "$__RW_A_DEST" ls-files --others --exclude-standard -z 2>/dev/null | tr '\0' '\n' | LC_ALL=C sort >"$__rw_dest_list"
cat "$__RW_A_STAGE/untracked.list" "$__RW_A_STAGE/protect.list" 2>/dev/null | LC_ALL=C sort -u >"$__rw_keep_list"
__rw_gone_list="$(mktemp "${TMPDIR:-/tmp}/rw-apply-gone.XXXXXX")"
LC_ALL=C comm -23 "$__rw_dest_list" "$__rw_keep_list" | grep -Ev '\.local-[0-9]{8}-[0-9]{6}/?$' >"$__rw_gone_list"
# Not a pipeline: a failed delete must fail the apply step itself. An entry
# ending in "/" is an untracked nested repository (or directory).
while IFS= read -r __rw_gone; do
  [ -n "$__rw_gone" ] || continue
  rm -rf -- "$__RW_A_DEST/${__rw_gone%/}" || exit 26
  # Directories the deletion emptied go too (git never tracks them).
  __rw_parent="$(dirname "$__RW_A_DEST/${__rw_gone%/}")"
  while [ "$__rw_parent" != "$__RW_A_DEST" ] && rmdir "$__rw_parent" 2>/dev/null; do
    __rw_parent="$(dirname "$__rw_parent")"
  done
done <"$__rw_gone_list"
rm -f "$__rw_dest_list" "$__rw_keep_list" "$__rw_gone_list"

rm -rf "$__RW_A_STAGE"
printf 'apply-ok\n'
EOS
    } >"$apply_script"

    local apply_out apply_status
    apply_out="$(exec_dest_script "$apply_script" 2>"$work_dir/apply.err")"
    apply_status=$?
    if [ "$apply_status" -ne 0 ] || [ "$apply_out" != "apply-ok" ]; then
      duration_ms="$(rw_elapsed_ms "$start_ts")"
      rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "apply_failed:exit=$apply_status"
      rw_warn "handoff sync: apply step failed on the destination (exit $apply_status): $(cat "$work_dir/apply.err" 2>/dev/null)."
      if [ -n "$backup_dir" ]; then
        rw_warn "The pre-overwrite destination backup is at '$backup_dir' on the destination host and can be restored manually (git fetch its bundle.git, git apply its patches, tar -x its untracked.tar)."
      fi
      return 4
    fi

    # --- post-apply verification: dest content must match captured source -
    dest_fp_after="$(rw_sync_fingerprint_via exec_dest_script "$dest_path" 2>/dev/null || echo EMPTY)"
    dest_fp_after="$(printf '%s' "$dest_fp_after" | tr -d '\r\n')"
    if [ "$dest_fp_after" != "$source_fingerprint" ]; then
      duration_ms="$(rw_elapsed_ms "$start_ts")"
      # A concurrent writer (live agent, editor, autosave) mutating the
      # source mid-handoff tears the transfer; it does not corrupt it.
      local source_fp_now
      source_fp_now="$(rw_sync_fingerprint_via exec_source_script "$source_path" 2>/dev/null || echo EMPTY)"
      source_fp_now="$(printf '%s' "$source_fp_now" | tr -d '\r\n')"
      if [ "$source_fp_now" != "$source_fingerprint" ]; then
        rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "source_changed_during_sync"
        rw_warn "handoff sync: the SOURCE workspace changed while the handoff was in flight (another writer -- a running agent, editor, or autosave -- is mutating '$source_path'). Nothing is corrupted; the destination holds the mid-flight snapshot. Stop or pause the other writer and re-run the handoff."
        return 4
      fi
      rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "post_apply_verify_mismatch"
      rw_warn "handoff sync: destination content does not match the captured source snapshot after apply (fingerprint mismatch). Destination was modified but is not verified correct -- inspect '$dest_path'; a pre-overwrite backup is at '${backup_dir:-<none, dest was empty>}'."
      return 4
    fi
  else
    exec_dest "mkdir -p $sq_dest" >/dev/null 2>&1 ||
      rw_die "handoff sync: could not create the destination directory '$dest_path'" 1
    # Plain roots have no git history to fall back on: back up, on the
    # destination host, every file this transfer will replace or delete.
    local at_risk="$work_dir/at-risk.list"
    rw_sync_manifest_diff "$src_now" "$dest_now" --no-deleted | cut -f2 >"$at_risk"
    if [ -s "$at_risk" ]; then
      backup_dir="$backup_root/$backup_token/$next_generation-$(date +%s)"
      local pbk="$work_dir/plain-backup.sh"
      {
        printf 'set -u\n'
        printf 'mkdir -p %q || exit 1\n' "$backup_dir"
        printf '__rw_list=%q/files.list\n' "$backup_dir"
        printf "cat >\"\$__rw_list\" <<'__RW_PLAIN_BACKUP_LIST__'\n"
        cat "$at_risk"
        printf '__RW_PLAIN_BACKUP_LIST__\n'
        # Keep-both renames already moved some listed files: back up what exists.
        # shellcheck disable=SC2016 # expands in the generated script
        printf 'cd %q || exit 1\n' "$dest_path"
        # shellcheck disable=SC2016 # expands in the generated script
        printf 'while IFS= read -r p; do if [ -e "$p" ] || [ -L "$p" ]; then printf "%%s\\n" "$p"; fi; done <"$__rw_list" >"$__rw_list.present"\n'
        # shellcheck disable=SC2016 # expands in the generated script
        printf 'COPYFILE_DISABLE=1 tar -cf %q/files.tar -T "$__rw_list.present" && printf "backup-ok\\n"\n' "$backup_dir"
      } >"$pbk"
      if [ "$(exec_dest_script "$pbk" 2>"$work_dir/plain-backup.err")" != "backup-ok" ]; then
        rw_warn "handoff sync: could not back up the $(wc -l <"$at_risk" | tr -d ' ') destination file(s) this transfer replaces ($(cat "$work_dir/plain-backup.err" 2>/dev/null)); nothing was overwritten."
        return 1
      fi
      rw_warn "handoff: backed up $(wc -l <"$at_risk" | tr -d ' ') destination file(s) to $backup_dir on the destination host"
    fi
  fi

  # =========================================================================
  # rsync channel.
  # =========================================================================
  local entries="$work_dir/ignored.entries" rules="$work_dir/rsync.rules"
  : >"$entries"
  if [ "$kind" = "git" ]; then
    # Union of both sides' collapsed ignored entries; the destination's list
    # is read AFTER apply so it uses the source's .gitignore.
    {
      rw_sync_ignored_via exec_source_script "$source_path"
      rw_sync_ignored_via exec_dest_script "$dest_path"
    } 2>/dev/null | tr -d '\r' | awk 'NF' | LC_ALL=C sort -u >"$entries"
  fi
  rw_sync_write_rsync_rules "$kind" "$entries" "$protect_list" "$rules"

  local rsync_src rsync_dst
  local rsync_args=(-rlptD --delete "--exclude-from=$rules")
  if [ "$dest_mode" = "ssh" ]; then
    rsync_args+=(-e "$(rw_ssh_bin) -o BatchMode=yes -o ConnectTimeout=$(rw_ssh_connect_timeout)")
  fi
  if [ "$pull" != "true" ]; then
    rsync_src="$source_path/"
    rsync_dst="$(rsync_far_path "$dest_path")/"
  else
    rsync_src="$(rsync_far_path "$source_path")/"
    rsync_dst="$dest_path/"
  fi
  if ! COPYFILE_DISABLE=1 rsync "${rsync_args[@]}" "$rsync_src" "$rsync_dst" >"$work_dir/rsync.out" 2>"$work_dir/rsync.err"; then
    duration_ms="$(rw_elapsed_ms "$start_ts")"
    rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "rsync_failed"
    local backup_note=""
    [ -n "$backup_dir" ] && backup_note=" (git backup at $backup_dir)"
    rw_warn "handoff sync: the rsync channel failed: $(tail -n 5 "$work_dir/rsync.err" 2>/dev/null). The destination may be partially updated; re-run the same command to converge$backup_note."
    return 4
  fi

  # --- post-transfer manifests: both sides must now list the same files ----
  local source_post="$work_dir/source.tsv" dest_post="$work_dir/dest.tsv"
  rw_sync_manifest_via exec_source_script "$source_path" "$kind" >"$source_post" 2>/dev/null || : >"$source_post"
  rw_sync_manifest_via exec_dest_script "$dest_path" "$kind" >"$dest_post" 2>/dev/null || : >"$dest_post"
  if ! rw_sync_manifests_equal "$source_post" "$dest_post"; then
    duration_ms="$(rw_elapsed_ms "$start_ts")"
    rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "fail" "rsync_verify_mismatch"
    rw_warn "handoff sync: after the rsync channel the two copies still differ ($(rw_sync_manifest_diff "$source_post" "$dest_post" | wc -l | tr -d ' ') file(s), e.g. $(rw_sync_manifest_diff "$source_post" "$dest_post" | head -n 3 | cut -f2 | paste -sd, -)). Usually another writer (a running agent, dev server, or build) is changing '$source_path'; stop it and re-run."
    return 4
  fi
  if [ "$kind" = "git" ]; then
    printf '#git\t%s\n' "$dest_fp_after" >>"$source_post"
    printf '#git\t%s\n' "$dest_fp_after" >>"$dest_post"
  fi
  exec_dest "rm -f $(rw_sync_shquote "$inflight_file")" >/dev/null 2>&1 || true
  if [ -n "$manifest_out" ]; then
    mkdir -p "$manifest_out"
    cp "$source_post" "$manifest_out/source.tsv"
    cp "$dest_post" "$manifest_out/dest.tsv"
  fi

  # --- record the new synchronization generation (git roots) ---------------
  if [ "$kind" = "git" ]; then
    local sync_json
    sync_json="$(jq -nc \
      --argjson generation "$next_generation" \
      --arg fingerprint "$dest_fp_after" \
      --arg direction "$direction" \
      --arg synced_at "$(rw_now_iso)" \
      --arg head_commit "$head_commit" \
      --arg branch "$branch" \
      --arg backup_dir "$backup_dir" \
      '{generation: $generation, fingerprint: $fingerprint, direction: $direction,
        synced_at: $synced_at, head_commit: $head_commit, branch: $branch,
        backup_dir: (if $backup_dir == "" then null else $backup_dir end)}')"
    if [ -n "$endpoint_id" ]; then
      rw_sync_gen_write_endpoint "$endpoint_id" "$sync_json"
    elif [ -n "$state_file" ]; then
      rw_sync_gen_write_statefile "$state_file" "$sync_json"
    fi
  fi

  duration_ms="$(rw_elapsed_ms "$start_ts")"
  rw_log_event "$direction" "$endpoint_id" "$dest_worker" "$duration_ms" "success" \
    "kind=$kind generation=$next_generation files=$(wc -l <"$dest_post" | tr -d ' ') renamed=$renamed_count overwritten=$overwritten_count"

  jq -nc \
    --argjson ok true \
    --arg kind "$kind" \
    --argjson generation "$next_generation" \
    --arg backup_dir "$backup_dir" \
    --arg head_commit "$head_commit" \
    --arg branch "$branch" \
    --arg fingerprint "$dest_fp_after" \
    --argjson renamed "$(jq -R . <"$protect_list" | jq -s .)" \
    --argjson overwritten "$overwritten_count" \
    --argjson duration_ms "$duration_ms" \
    '{ok: $ok, kind: $kind, generation: $generation,
      backup_dir: (if $backup_dir == "" then null else $backup_dir end),
      head_commit: (if $head_commit == "" then null else $head_commit end),
      branch: (if $branch == "" then null else $branch end),
      fingerprint: (if $fingerprint == "" then null else $fingerprint end),
      renamed: $renamed, overwritten: $overwritten, duration_ms: $duration_ms}'
  return 0
}

rw_sync_stable_slug() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}' | cut -c1-12
  else
    shasum -a 256 | awk '{print $1}' | cut -c1-12
  fi
}

[ $# -ge 1 ] || {
  usage >&2
  exit 64
}
command="$1"
shift
case "$command" in
  sync) cmd_sync "$@"; exit $? ;;
  fingerprint) cmd_fingerprint "$@"; exit $? ;;
  manifest) cmd_manifest "$@"; exit $? ;;
  -h | --help | help) usage; exit 0 ;;
  *)
    printf 'handoff: unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 64
    ;;
esac
