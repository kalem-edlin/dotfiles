#!/usr/bin/env bash
# Local unbound-endpoint report. Lists registered endpoints that no live
# local pane carries (@rw-endpoint) -- typically a pane killed without
# `prefix q`, or a laptop restore that has not reattached yet.
#
# REPORT ONLY (decision D14, docs/tasks/remote-owned-directories.md): a worker
# session is killed only by an explicit hand-back, `rw forget`, or
# `rw close`. A registered endpoint whose pane is not found is logged and
# left alone -- its worker session (and any agent in it) keeps running, and
# the picker keeps showing the root as remote. Before 2026-11-18 this
# script closed such endpoints once it could prove the binding belonged to
# the current server generation; that destroyed remote agents whenever a
# restore failed to rebind a pane.
#
# Usage: reconcile-local [--min-age <seconds>] [--dry-run]
#
#   --min-age  ignore endpoints younger than this (default 120s,
#              RW_LOCAL_RECONCILE_MIN_AGE_SECONDS): handoff/open write the
#              registry entry a moment before stamping pane options.
#   --dry-run  same report, without the rw.log line (used by `rw doctor`).
#
# No tmux server, or a failed listing, reports nothing (never "everything
# is unbound").

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../scripts/common.sh
source "$SCRIPT_DIR/../scripts/common.sh"

rw_need_jq
rw_config_valid || rw_die "reconcile-local: config.json ($RW_CONFIG_FILE) is invalid"

dry_run="false"
min_age="${RW_LOCAL_RECONCILE_MIN_AGE_SECONDS:-120}"
while [ $# -gt 0 ]; do
  case "$1" in
    --min-age) min_age="${2:?}"; shift 2 ;;
    --dry-run) dry_run="true"; shift ;;
    *) rw_die "reconcile-local: unknown argument: $1" 64 ;;
  esac
done
case "$min_age" in *[!0-9]* | '') rw_die "reconcile-local: --min-age must be a non-negative integer" 64 ;; esac

iso_to_epoch() {
  # macOS/BSD first (the focus machine), GNU fallback; empty on failure so
  # callers can treat an unparseable timestamp as "no proof, skip".
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null ||
    date -u -d "$1" +%s 2>/dev/null || true
}

endpoints_dir="$(rw_endpoints_dir)"
[ -d "$endpoints_dir" ] || exit 0

# One listing: pane id plus its @rw-endpoint (empty for local panes).
pane_listing="$(tmux list-panes -a -F '#{pane_id} #{@rw-endpoint}' 2>/dev/null)" || exit 0
[ -n "$pane_listing" ] || exit 0
live_ids="$(printf '%s\n' "$pane_listing" | awk 'NF == 2 { print $2 }')"

now_epoch="$(date +%s)"

unbound=()
for f in "$endpoints_dir"/*.json; do
  [ -f "$f" ] || continue
  id="$(jq -r '.endpoint_id // empty' "$f" 2>/dev/null)"
  [ -n "$id" ] || continue
  grep -Fqx "$id" <<<"$live_ids" && continue # bound to a live pane

  created_at="$(jq -r '.created_at // empty' "$f" 2>/dev/null)"
  created_epoch="$(iso_to_epoch "$created_at")"
  case "$created_epoch" in *[!0-9]* | '') continue ;; esac
  [ $((now_epoch - created_epoch)) -ge "$min_age" ] || continue

  unbound+=("$id")
done

count="${#unbound[@]}"
if [ "$dry_run" = "true" ]; then
  echo "rw reconcile-local: unbound=$count ids=${unbound[*]:-none} (report only; never closed)"
  exit 0
fi
[ "$count" -gt 0 ] || exit 0
rw_log "reconcile-local: $count registered endpoint(s) have no live local pane, left running: ${unbound[*]}"
echo "rw reconcile-local: unbound=$count ids=${unbound[*]} (left running)"
