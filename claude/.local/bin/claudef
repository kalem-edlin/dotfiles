#!/bin/sh
set -eu

profile=${CLAUDEF_PROFILE:-"$HOME/.config/claudef"}
plugin_dir="$profile"
# Load the plugin at its source so new shared skills need no restow.
if [ -r "$profile/.claude-plugin/plugin.json" ]; then
  plugin_dir=$(dirname "$(dirname "$(realpath "$profile/.claude-plugin/plugin.json")")")
fi
prompt_link="$profile/communication.md"
prompt=""
native_ccline="$HOME/.claude/ccline"

# Build the shared communication prompt. Operational references such as
# agents/upstream_audit.md are deliberately not system instructions.
if [ -r "$prompt_link" ]; then
  agents_dir=$(dirname "$(realpath "$prompt_link")")
  prompt_dir="${XDG_STATE_HOME:-$HOME/.local/state}/focus-agents"
  prompt="$prompt_dir/prompt.md"
  mkdir -p "$prompt_dir"
  prompt_tmp="$prompt.tmp.$$"
  : > "$prompt_tmp"
  cat "$agents_dir/communication.md" > "$prompt_tmp"
  mv "$prompt_tmp" "$prompt"
fi

# ccline reads configuration from Claude's native directory. Link only its
# tracked configuration; credentials and mutable cache files remain native.
mkdir -p "$native_ccline/themes"
for name in config.toml models.toml; do
  source="$profile/ccline/$name"
  target="$native_ccline/$name"
  if [ -r "$source" ] && { [ -L "$target" ] || [ ! -e "$target" ]; }; then
    ln -sfn "$source" "$target"
  fi
done
source="$profile/ccline/themes/personal.toml"
target="$native_ccline/themes/personal.toml"
if [ -r "$source" ] && { [ -L "$target" ] || [ ! -e "$target" ]; }; then
  ln -sfn "$source" "$target"
fi

if [ -n "$prompt" ] && [ -r "$prompt" ]; then
  exec env -u CLAUDE_CONFIG_DIR claude \
    --dangerously-skip-permissions \
    --settings "$profile/settings.json" \
    --setting-sources user,project,local \
    --plugin-dir "$plugin_dir" \
    --system-prompt-snapshot off \
    --append-system-prompt-file "$prompt" \
    "$@"
fi

exec env -u CLAUDE_CONFIG_DIR claude \
  --dangerously-skip-permissions \
  --settings "$profile/settings.json" \
  --setting-sources user,project,local \
  --plugin-dir "$plugin_dir" \
  --system-prompt-snapshot off \
  "$@"
