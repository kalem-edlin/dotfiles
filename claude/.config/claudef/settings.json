{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "deny": [
      "Task(claude-code-guide)",
      "Task(Plan)",
      "Task(Explore)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5-1[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "autoCompactWindow": 400000
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "switchModelsOnFlag": true,
  "feedbackDrafts": "off",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-workspace-resurrect/scripts/record-agent-session.sh\" claude",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude SessionStart",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claudef/hooks/bash-close-stdin.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude PreToolUse",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude PostToolUse",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|elicitation_url_dialog|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude Notification",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude SubagentStart",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude SubagentStop",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude Stop",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude CwdChanged",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/tmux/local-plugins/tmux-agent-sessions/scripts/agent-state\" claude SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.config/claudef/ccline/statusline.py\""
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "bashEditDiffEnabled": false,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "artifact-capabilities": "name-only",
    "artifact-diagramming": "name-only",
    "update-config": "name-only",
    "workflow-authoring": "name-only"
  }
}
