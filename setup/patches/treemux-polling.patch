+is_positive_interval() {
+	local interval="$1"
+	local digits
+
+	[[ "$interval" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
+	digits="${interval//[^0-9]/}"
+	[[ "$digits" =~ [1-9] ]]
+}
+
+for interval_name in REFRESH_INTERVAL REFRESH_INTERVAL_INACTIVE_PANE REFRESH_INTERVAL_INACTIVE_WINDOW; do
+	interval="${!interval_name}"
+	if ! is_positive_interval "$interval"; then
+		echo "Invalid $interval_name: $interval. Expected a positive number." >&2
+		exit 107
+	fi
+done
+
+main_window_has_attached_client() {
+	local main_session main_window client_session client_window
+
+	IFS=' ' read -r main_session main_window < <(
+		tmux display-message -p -t "$MAIN_PANE_ID" '#{session_id} #{window_id}' 2>/dev/null
+	)
+	[[ -n "$main_session" && -n "$main_window" ]] || return 1
+
+	while IFS=' ' read -r client_session client_window; do
+		if [[ "$client_window" == "$main_window" ]]; then
+			return 0
+		fi
+	done < <(tmux list-clients -F '#{session_id} #{window_id}' 2>/dev/null)
+
+	return 1
+}
+
+main_pane_cwd() {
+	tmux display-message -p -t "$MAIN_PANE_ID" '#{pane_current_path}' 2>/dev/null
+}
+
+set_poll_state() {
+	local main_pane_active side_pane_active
+
+	WINDOW_VISIBLE=0
+	POLL_INTERVAL="$REFRESH_INTERVAL_INACTIVE_WINDOW"
+	if ! main_window_has_attached_client; then
+		return
+	fi
+
+	WINDOW_VISIBLE=1
+	main_pane_active=$(tmux display-message -p -t "$MAIN_PANE_ID" '#{pane_active}' 2>/dev/null)
+	side_pane_active=$(tmux display-message -p -t "$SIDE_PANE_ID" '#{pane_active}' 2>/dev/null)
+	if [[ "$main_pane_active" == 1 || "$side_pane_active" == 1 ]]; then
+		POLL_INTERVAL="$REFRESH_INTERVAL"
+	else
+		POLL_INTERVAL="$REFRESH_INTERVAL_INACTIVE_PANE"
+	fi
+}
+
+initialise_tree() {
+	local tree_filetype tree_root_dir exit_code
+
+	echo "Waiting for the nvim-tree/neo-tree.."
+	tree_filetype=$("$PYTHON_COMMAND" "$CURRENT_DIR/wait_treeinit.py" "$NVIM_ADDR")
+	exit_code=$?
+	if [[ $exit_code -ne 0 ]]; then
+		echo "$CURRENT_DIR/wait_treeinit.py exited with code $exit_code."
+		if [[ $exit_code -eq 50 ]]; then
+			echo "pynvim not installed. Exiting.."
+			exit 106
+		elif [[ $exit_code -eq 51 ]]; then
+			echo "Nvim is not installed or could not be loaded. Exiting.."
+			exit 103
+		elif [[ $exit_code -eq 52 ]]; then
+			echo "Nvim-Tree/Neo-Tree is not installed or could not be loaded. Exiting.."
+			exit 104
+		else
+			echo "Unknown error. Exiting.."
+			exit 105
+		fi
+	fi
+
+	tree_root_dir=$("$PYTHON_COMMAND" "$CURRENT_DIR/go_random_within_rootdir.py" "$NVIM_ADDR" "$main_pane_prevcwd" "$SIDE_PANE_ROOT")
+	echo "$tree_filetype detected!"
+	echo "Detected side pane root: $tree_root_dir"
+	side_pane_root="$tree_root_dir"
+}
+
