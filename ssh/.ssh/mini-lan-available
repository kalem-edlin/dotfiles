#!/bin/sh
# Return success when the Mac mini's ordinary SSH listener is reachable on
# the local network. ssh_config uses this only to choose a HostName; the real
# SSH connection still performs normal host-key verification.
#
# Usage: mini-lan-available <lan-hostname>
# The hostname comes from the caller (the `Match ... exec` line in the
# untracked ~/.ssh/config.local); without it the check fails quietly.

[ -n "$1" ] || exit 1
lan_host="$1"
lan_port="${MINI_LAN_PORT:-22}"

command -v nc >/dev/null 2>&1 || exit 1

# nc's -G/-w bound the TCP connect but NOT name resolution: when the mini is
# off, mDNS resolution of the .local name blocks ~5s, and ssh runs this check
# during config evaluation -- so every connection attempt (and every rw-picker
# probe) ate that stall before even trying Tailscale (found 2026-08-05). The
# watchdog bounds the whole check instead.
# Only ever run in the background: `exec` makes $! the nc process itself, so
# the watchdog's kill ends nc instead of orphaning it for the rest of its
# ~5 s mDNS stall.
run_nc() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) exec nc -z -G 1 -w 1 "$lan_host" "$lan_port" >/dev/null 2>&1 ;;
    *) exec nc -z -w 1 "$lan_host" "$lan_port" >/dev/null 2>&1 ;;
  esac
}

# Runs in a function with stderr silenced so the shell's own "Terminated"
# job notice (from the watchdog kill) never reaches ssh's output.
check_with_watchdog() {
  run_nc &
  nc_pid=$!
  (
    sleep 1.5
    kill "$nc_pid" 2>/dev/null
  ) &
  watchdog=$!
  wait "$nc_pid"
  rc=$?
  kill "$watchdog" 2>/dev/null
  return "$rc"
}

# Negative-result cache (found 2026-11-18). Away from the LAN the watchdog
# above still costs its full 1.5 s, and ssh pays it on EVERY invocation,
# even one that rides an open ControlMaster socket: `ssh mini true` took
# 1.65 s of which 0.12 s was the network. Every tmux-remote-workspaces key
# that talks to the worker (prefix [, splits, q, c) waited on it.
#
# Only a "not reachable" answer is cached, keyed by the current network
# (default gateway + interface), and served instantly; once it is older than
# MINI_LAN_RECHECK seconds the next call still answers from the cache but
# re-checks in the background. A stale negative is harmless: ssh takes the
# Tailscale route, which works on the LAN too. A positive answer is never
# cached, so a stale cache can never send ssh to an unreachable LAN name.
# A changed network misses the cache and checks synchronously, as before.
recheck_after="${MINI_LAN_RECHECK:-60}"
cache_dir="${MINI_LAN_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mini-lan-available}"
cache_file="$cache_dir/$(printf '%s' "$lan_host:$lan_port" | tr -c 'A-Za-z0-9._-' '_')"

network_key() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) route -n get default 2>/dev/null | awk '$1 == "gateway:" || $1 == "interface:" { printf "%s ", $2 }' ;;
    *) ip route show default 2>/dev/null | head -n 1 ;;
  esac
}

# Writes "<epoch> <network key>" when the LAN is unreachable, removes the
# cache entry when it is reachable. Returns the check's status.
check_and_record() {
  if check_with_watchdog 2>/dev/null; then
    rm -f "$cache_file" 2>/dev/null
    return 0
  fi
  mkdir -p "$cache_dir" 2>/dev/null &&
    printf '%s %s\n' "$(date +%s)" "$net" >"$cache_file.$$" 2>/dev/null &&
    mv -f "$cache_file.$$" "$cache_file" 2>/dev/null
  return 1
}

net="$(network_key | sed 's/ *$//')"
if [ -n "$net" ] && [ -f "$cache_file" ]; then
  read -r cached_at cached_net <"$cache_file" 2>/dev/null
  if [ "$cached_net" = "$net" ]; then
    now="$(date +%s)"
    case "$cached_at" in '' | *[!0-9]*) cached_at=0 ;; esac
    if [ $((now - cached_at)) -ge "$recheck_after" ]; then
      # Claim the re-check (fresh timestamp) so a burst of ssh calls starts
      # one, then run it fully detached: ssh waits only for this process,
      # and no descriptor of the caller (a $(ssh ... 2>&1) pipe) may stay
      # open in the background job.
      printf '%s %s\n' "$now" "$net" >"$cache_file" 2>/dev/null
      (check_and_record) </dev/null >/dev/null 2>&1 &
    fi
    exit 1
  fi
fi

[ -n "$net" ] || { check_with_watchdog 2>/dev/null; exit "$?"; }
# stderr silenced here too: the watchdog's "Terminated" notice surfaces in
# the caller of the function that killed it.
check_and_record 2>/dev/null
exit "$?"
