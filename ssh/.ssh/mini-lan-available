#!/bin/sh
# Return success when the Mac mini's ordinary SSH listener is reachable on
# the local network. ssh_config uses this only to choose a HostName; the real
# SSH connection still performs normal host-key verification.

lan_host="${MINI_LAN_HOST:-Alfies-Mac-mini.local}"
lan_port="${MINI_LAN_PORT:-22}"

command -v nc >/dev/null 2>&1 || exit 1

# nc's -G/-w bound the TCP connect but NOT name resolution: when the mini is
# off, mDNS resolution of the .local name blocks ~5s, and ssh runs this check
# during config evaluation -- so every connection attempt (and every rw-picker
# probe) ate that stall before even trying Tailscale (found 2026-08-05). The
# watchdog bounds the whole check instead.
run_nc() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) nc -z -G 1 -w 1 "$lan_host" "$lan_port" >/dev/null 2>&1 ;;
    *) nc -z -w 1 "$lan_host" "$lan_port" >/dev/null 2>&1 ;;
  esac
}

# Runs in a function with stderr silenced so the shell's own "Terminated"
# job notice (from the watchdog kill) never reaches ssh's output.
check_with_watchdog() {
  run_nc &
  nc_pid=$!
  (
    sleep 1.5
    kill "$nc_pid" 2>/dev/null
  ) &
  watchdog=$!
  wait "$nc_pid"
  rc=$?
  kill "$watchdog" 2>/dev/null
  return "$rc"
}

check_with_watchdog 2>/dev/null
exit "$?"
