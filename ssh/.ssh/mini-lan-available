#!/bin/sh
# Return success when the Mac mini's ordinary SSH listener is reachable on
# the local network. ssh_config uses this only to choose a HostName; the real
# SSH connection still performs normal host-key verification.

lan_host="${MINI_LAN_HOST:-Alfies-Mac-mini.local}"
lan_port="${MINI_LAN_PORT:-22}"

command -v nc >/dev/null 2>&1 || exit 1

case "$(uname -s 2>/dev/null)" in
  Darwin)
    nc -z -G 1 -w 1 "$lan_host" "$lan_port" >/dev/null 2>&1
    ;;
  *)
    nc -z -w 1 "$lan_host" "$lan_port" >/dev/null 2>&1
    ;;
esac
