# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Default settings for all hosts
Host *
    # macOS Keychain integration (UseKeychain is a macOS-only option; guard
    # it so Linux OpenSSH doesn't fail with "Bad configuration option")
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes

    # Only use explicitly configured keys
    IdentitiesOnly yes

    # Prompt dead-connection detection so the reconnect loop notices a lost
    # link quickly instead of hanging on a half-open TCP connection
    ServerAliveInterval 15
    ServerAliveCountMax 4

    # Multiplex connections for fast reattach (e.g. tmux reconnect loop
    # re-running `ssh -t <worker> tmux new -A -s <endpoint>`). ~/.ssh/sockets
    # is created from zsh/.zshenv since ssh will not create it itself.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

# Remote Linux worker
Host agents-roll
    HostName 76.13.137.3
    User root
    IdentityFile ~/.ssh/id_ed25519


# Example: Server shortcut
# Host myserver
#     HostName server.example.com
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22

  # Prefer the Mini's ordinary LAN listener when it is reachable. OpenSSH
  # keeps the first value it obtains for each option, so the later Host block
  # supplies the Tailscale address only when this conditional did not set a
  # HostName. The logical alias remains `mini` on both routes.
  Match originalhost mini exec "~/.ssh/mini-lan-available"
      HostName Alfies-Mac-mini.local

  Match all

  Host mini
      HostName 100.67.127.104
      HostKeyAlias 100.67.127.104
      User alfierobertson

  # Direct same-LAN route for lower latency and as a fallback while
  # troubleshooting or restarting Tailscale on the Mac mini.
  Host mini-lan
      HostName Alfies-Mac-mini.local
      User alfierobertson
      HostKeyAlias 100.67.127.104
