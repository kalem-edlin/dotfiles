# Default settings for all hosts
Host *
    # macOS Keychain integration
    AddKeysToAgent yes
    UseKeychain yes
    
    # Only use explicitly configured keys
    IdentitiesOnly yes

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519


# Example: Server shortcut
# Host myserver
#     HostName server.example.com
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22

